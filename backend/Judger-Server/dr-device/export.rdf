<?xml version='1.0' encoding="UTF-8"?>
<!DOCTYPE rdf:RDF [
     <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#">
     <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#">
     <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#">
     <!ENTITY defeasible "http://lpis.csd.auth.gr/systems/dr-device/defeasible.rdfs#">
     <!ENTITY export "http://startrek.csd.auth.gr/dr-device/export/export.rdf#"> 
     <!ENTITY proof-export "http://startrek.csd.auth.gr/dr-device/proof/proof.ruleml#"> 
]>

<rdf:RDF
     xmlns:rdf='&rdf;'
     xmlns:rdfs='&rdfs;'
     xmlns:defeasible='&defeasible;'
     xmlns:export='&export;'
>

<rdfs:Class rdf:about='&export;to_increase_penalty'>
     <rdfs:label rdf:resource='to_increase_penalty'/>
     <rdfs:subClassOf rdf:resource='&defeasible;DefeasibleObject'/>
</rdfs:Class>

<rdfs:Class rdf:about='&export;not_previously_convicted'>
     <rdfs:label rdf:resource='not_previously_convicted'/>
     <rdfs:subClassOf rdf:resource='&defeasible;DefeasibleObject'/>
</rdfs:Class>


<rdf:Property rdf:about='&export;value'>
     <rdfs:domain rdf:resource='&export;to_increase_penalty'/>
</rdf:Property>

<rdf:Property rdf:about='&export;defendant'>
     <rdfs:domain rdf:resource='&export;not_previously_convicted'/>
</rdf:Property>

<export:to_increase_penalty rdf:about='&export;to_increase_penalty1'>
     <export:value>true</export:value>
     <defeasible:truthStatus>defeasibly-proven-positive</defeasible:truthStatus>
     <defeasible:proof rdf:datatype='&xsd;anyURI'>&proof-export;proof1</defeasible:proof>
</export:to_increase_penalty>

<export:not_previously_convicted rdf:about='&export;not_previously_convicted1'>
     <export:defendant>John Doe</export:defendant>
     <defeasible:truthStatus>defeasibly-proven-positive</defeasible:truthStatus>
     <defeasible:proof rdf:datatype='&xsd;anyURI'>&proof-export;proof2</defeasible:proof>
</export:not_previously_convicted>

</rdf:RDF>
