                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <!--                Negacije ps7-->
        <lrml:PrescriptiveStatement key="ps7_4">
            <ruleml:Rule key=":rule7_4" closure="universal" strength="defeasible">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Atom>
                            <ruleml:Rel>coercion_abuse</ruleml:Rel>
                            <ruleml:Var type=":defendant">Defendant</ruleml:Var>
                        </ruleml:Atom>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Negation>
                        <ruleml:Atom>
                            <ruleml:Rel>movement_restrictions_on_duty</ruleml:Rel>
                            <ruleml:Var type=":defendant">Defendant</ruleml:Var>
                        </ruleml:Atom>
                    </ruleml:Negation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>

        <!--        Prinuda vise okrivljenih-->
        <lrml:PrescriptiveStatement key="ps8">
            <ruleml:Rule key=":rule8" closure="universal" strength="defeasible">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Or>
                            <ruleml:Atom>
                                <ruleml:Rel iri="lc:num_of_victims"/>
                                <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                                <ruleml:Var type="num_of_victims">num_of_defendants</ruleml:Var>
                            </ruleml:Atom>

                            <ruleml:Atom>
                                <ruleml:Rel iri="lc:psychological_abuse_involved"/>
                                <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                                <ruleml:Data xsi:type="xs:string">true</ruleml:Data>
                            </ruleml:Atom>
                            <ruleml:Atom>
                                <ruleml:Rel iri="lc:physical_abuse_involved"/>
                                <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                                <ruleml:Data xsi:type="xs:string">true</ruleml:Data>
                            </ruleml:Atom>
                        </ruleml:Or>
                        <ruleml:Atom>
                            <ruleml:Rel iri="lc:injury_severity"/>
                            <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                            <ruleml:Data xsi:type="xs:string">BLACKMAIL</ruleml:Data>
                        </ruleml:Atom>
                        <ruleml:Expr>
                            <ruleml:Fun>&gt;</ruleml:Fun>
                            <ruleml:Var>num_of_defendants</ruleml:Var>
                            <ruleml:Ind>1</ruleml:Ind>
                        </ruleml:Expr>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Atom>
                        <ruleml:Rel>coercion_abuse_multiple_defendant</ruleml:Rel>
                        <ruleml:Var type=":defendant">Defendant</ruleml:Var>
                    </ruleml:Atom>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>


        <!--                Negacije ps7-->
        <lrml:PrescriptiveStatement key="ps8_1">
            <ruleml:Rule key=":rule8_1" closure="universal" strength="defeasible">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Atom>
