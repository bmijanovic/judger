                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Negation>
                        <ruleml:Atom>
                            <ruleml:Rel>psychological_abuse_on_duty</ruleml:Rel>
                            <ruleml:Var type=":defendant">Defendant</ruleml:Var>
                        </ruleml:Atom>
                    </ruleml:Negation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <!--        Ogranicavanje slobode kretanja na duznosti-->
        <lrml:PrescriptiveStatement key="ps4">
            <ruleml:Rule key=":rule4" closure="universal" strength="defeasible">
                <ruleml:if>
                    <ruleml:And>

                        <ruleml:Or>
                            <ruleml:Atom>
                                <ruleml:Rel iri="lc:physical_abuse_involved"/>
                                <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                                <ruleml:Data xsi:type="xs:string">true</ruleml:Data>
                            </ruleml:Atom>

                            <ruleml:Atom>
                                <ruleml:Rel iri="lc:psychological_abuse_involved"/>
                                <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                                <ruleml:Data xsi:type="xs:string">true</ruleml:Data>
                            </ruleml:Atom>
                        </ruleml:Or>

                        <ruleml:Atom>
                            <ruleml:Rel iri="lc:on_duty"/>
                            <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                            <ruleml:Data xsi:type="xs:string">true</ruleml:Data>
                        </ruleml:Atom>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Atom>
                        <ruleml:Rel>movement_restrictions_on_duty</ruleml:Rel>
                        <ruleml:Var type=":defendant">Defendant</ruleml:Var>
                    </ruleml:Atom>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <!--                Negacija ps4-->
        <lrml:PrescriptiveStatement key="ps4_1">
            <ruleml:Rule key=":rule4_1" closure="universal" strength="defeasible">
                <ruleml:if>
