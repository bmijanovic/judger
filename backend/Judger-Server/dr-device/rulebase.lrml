                        <ruleml:Atom>
                            <ruleml:Rel>psychological_abuse</ruleml:Rel>
                            <ruleml:Var type=":defendant">Defendant</ruleml:Var>
                        </ruleml:Atom>
                    </ruleml:Negation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <!--                Negacija ps4-->
        <lrml:PrescriptiveStatement key="ps4_2">
            <ruleml:Rule key=":rule4_2" closure="universal" strength="defeasible">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Atom>
                            <ruleml:Rel>movement_restrictions_on_duty</ruleml:Rel>
