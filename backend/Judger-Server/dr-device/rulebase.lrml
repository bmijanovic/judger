        <!--                Prinuda-->
        <!--        Ucena zlostavljanje zivotno ugrozen-->
        <lrml:PrescriptiveStatement key="ps7">
            <ruleml:Rule key=":rule7" closure="universal" strength="defeasible">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Or>
                            <ruleml:Atom>
                                <ruleml:Rel iri="lc:psychological_abuse_involved"/>
                                <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                                <ruleml:Data xsi:type="xs:string">true</ruleml:Data>
                            </ruleml:Atom>
                            <ruleml:Atom>
                                <ruleml:Rel iri="lc:physical_abuse_involved"/>
                                <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                                <ruleml:Data xsi:type="xs:string">true</ruleml:Data>
                            </ruleml:Atom>
                        </ruleml:Or>
                        <ruleml:Atom>
                            <ruleml:Rel iri="lc:injury_severity"/>
                            <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                            <ruleml:Data xsi:type="xs:string">BLACKMAIL</ruleml:Data>
                        </ruleml:Atom>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Atom>
                        <ruleml:Rel>coercion_abuse</ruleml:Rel>
                        <ruleml:Var type=":defendant">Defendant</ruleml:Var>
                    </ruleml:Atom>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>


