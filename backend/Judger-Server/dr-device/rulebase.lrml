<?xml version="1.0" encoding="UTF-8"?>
<lrml:LegalRuleML xmlns:lrml="http://docs.oasis-open.org/legalruleml/ns/v1.0/"
                  xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://docs.oasis-open.org/legalruleml/ns/v1.0/ xsd-compact/lrml-compact.xsd"
                  xmlns:ruleml="http://ruleml.org/spec">
    <lrml:Statements>

        <!--        Psihicko zlostavljanje-->
        <lrml:PrescriptiveStatement key="ps1">
            <ruleml:Rule key=":rule1" closure="universal" strength="defeasible">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Atom>
                            <ruleml:Rel iri="lc:psychological_abuse_involved"/>
                            <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                            <ruleml:Data xsi:type="xs:string">true</ruleml:Data>
                        </ruleml:Atom>

                        <ruleml:Atom>
                            <ruleml:Rel iri="lc:physical_abuse_involved"/>
                            <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                            <ruleml:Data xsi:type="xs:string">false</ruleml:Data>
                        </ruleml:Atom>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Atom>
                        <ruleml:Rel>psychological_abuse</ruleml:Rel>
                        <ruleml:Var type=":defendant">Defendant</ruleml:Var>
                    </ruleml:Atom>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
                Psihicko zlostavljanje na duznosti
        <lrml:PrescriptiveStatement key="ps2">
            <ruleml:Rule key=":rule2" closure="universal" strength="defeasible">
                <ruleml:if>
                    <ruleml:And>

                        <ruleml:Atom>
                            <ruleml:Rel iri="lc:psychological_abuse_involved"/>
                            <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                            <ruleml:Data xsi:type="xs:string">true</ruleml:Data>
                        </ruleml:Atom>

                        <ruleml:Atom>
                            <ruleml:Rel iri="lc:physical_abuse_involved"/>
                            <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                            <ruleml:Data xsi:type="xs:string">false</ruleml:Data>
                        </ruleml:Atom>

                        <ruleml:Atom>
                            <ruleml:Rel iri="lc:on_duty"/>
                            <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                            <ruleml:Data xsi:type="xs:string">true</ruleml:Data>
                        </ruleml:Atom>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Atom>
                        <ruleml:Rel>psychological_abuse_on_duty</ruleml:Rel>
                        <ruleml:Var type=":defendant">Defendant</ruleml:Var>
                    </ruleml:Atom>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <!--                Negacija ps2-->
        <lrml:PrescriptiveStatement key="ps2_1">
            <ruleml:Rule key=":rule2_1" closure="universal" strength="defeasible">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Atom>
                            <ruleml:Rel>psychological_abuse_on_duty</ruleml:Rel>
                            <ruleml:Var type=":defendant">Defendant</ruleml:Var>
                        </ruleml:Atom>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Negation>
                        <ruleml:Atom>
                            <ruleml:Rel>psychological_abuse</ruleml:Rel>
                            <ruleml:Var type=":defendant">Defendant</ruleml:Var>
                        </ruleml:Atom>
                    </ruleml:Negation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <!--        Ogranicanvanje slobode kretanja-->
        <lrml:PrescriptiveStatement key="ps3">
            <ruleml:Rule key=":rule3" closure="universal" strength="defeasible">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Atom>
                            <ruleml:Rel iri="lc:num_of_victims"/>
                            <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                            <ruleml:Var type="num_of_victims">num_of_defendants</ruleml:Var>
                        </ruleml:Atom>
                        <ruleml:Or>
                                <ruleml:Atom>
                                    <ruleml:Rel iri="lc:physical_abuse_involved"/>
                                    <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                                    <ruleml:Data xsi:type="xs:string">true</ruleml:Data>
                                </ruleml:Atom>

                                <ruleml:Atom>
                                    <ruleml:Rel iri="lc:psychological_abuse_involved"/>
                                    <ruleml:Var type="lc:defendant">Defendant</ruleml:Var>
                                    <ruleml:Data xsi:type="xs:string">true</ruleml:Data>
                                </ruleml:Atom>
                        </ruleml:Or>

                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Atom>
                        <ruleml:Rel>movement_restrictions</ruleml:Rel>
                        <ruleml:Var type=":defendant">Defendant</ruleml:Var>
                    </ruleml:Atom>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <!--                Negacija ps3-->
        <lrml:PrescriptiveStatement key="ps3_1">
            <ruleml:Rule key=":rule3_1" closure="universal" strength="defeasible">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Atom>
                            <ruleml:Rel>movement_restrictions</ruleml:Rel>
                            <ruleml:Var type=":defendant">Defendant</ruleml:Var>
                        </ruleml:Atom>
                    </ruleml:And>
                </ruleml:if>
                <ruleml:then>
                    <ruleml:Negation>
                        <ruleml:Atom>
                            <ruleml:Rel>psychological_abuse</ruleml:Rel>
                            <ruleml:Var type=":defendant">Defendant</ruleml:Var>
                        </ruleml:Atom>
                    </ruleml:Negation>
                </ruleml:then>
            </ruleml:Rule>
        </lrml:PrescriptiveStatement>
        <!--                Negacija ps3-->
        <lrml:PrescriptiveStatement key="ps3_2">
            <ruleml:Rule key=":rule3_2" closure="universal" strength="defeasible">
                <ruleml:if>
                    <ruleml:And>
                        <ruleml:Atom>
                            <ruleml:Rel>movement_restrictions</ruleml:Rel>
                            <ruleml:Var type=":defendant">Defendant</ruleml:Var>
